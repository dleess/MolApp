[Desktop Entry]
Type=Application
Name=MolApp
GenericName=Molecule Viewer
Comment=Mol*-powered molecular structure viewer
# `molapp` is what the .deb installs (packaging/build-deb.sh). Running from a checkout instead:
# point Exec at linux/molapp-linux before copying this file to ~/.local/share/applications/.
Exec=molapp
Icon=com.donghan.molapp
Terminal=false
Categories=Science;Chemistry;Biology;Education;
MimeType=chemical/x-pdb;chemical/x-mmcif;
StartupWMClass=molapp
